{
  "contextFileName": ["GEMINI.md", "CLAUDE.md"],
  "excludeTools": ["run_shell_command(rm -rf)"],
  "authAccept": true,
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    }
  },
  "checkpointing": {
    "enabled": true
  }
}
