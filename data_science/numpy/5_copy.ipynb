   "source": [
    "x = np.array([1,2,3])\n",
    "y = x[0:3] # list slicing is deep copy\n",
    "y[0] = 10\n",
    "\n",
    "print(x)\n",
    "print(y)\n",
    "print(x is y)"
   ]
  }
