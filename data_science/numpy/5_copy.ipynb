   "source": [
    "import numpy as np\n",
    "a = [1,2,3]\n",
    "x = np.array(a)\n",
    "y = x     # shallow copy\n",
    "y[0]=10\n",
    "\n",
    "print(a)\n",
    "print(x)\n",
    "print(y)\n",
    "print(x is y)\n",
    "\n",
    "z = x.copy()   # deep copy\n",
    "print(z is x)"
   ]
  },
